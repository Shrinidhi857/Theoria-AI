# Gemini API Key configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default model override
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (PostgreSQL URL or sqlite fallback sqlite:///./theoria.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/theoria_db

# Security & JWT Token Config
SECRET_KEY=change_this_to_a_super_secret_jwt_signing_key_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Neo4j Knowledge Graph Configuration (Neo4j AuraDB or self-hosted)
NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://56b8f669.databases.neo4j.io
NEO4J_USERNAME=56b8f669
NEO4J_PASSWORD=HilVVWE6nHiFujQLm2Sj-obHOYbH64d-1YWy8OX-VN8
NEO4J_DATABASE=56b8f669
